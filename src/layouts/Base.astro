---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PreviewDialog from '../components/PreviewDialog.astro';
import { lessonSummary, videoCount } from '../data/catalog';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'stat' | 'lae' | 'what' | 'econ' | 'cases' | 'tea' | 'tracks' | 'search';
}

const { title, description, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const icon = `${import.meta.env.BASE_URL}favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={icon} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Masthead current={current} />
    <main id="content" tabindex="-1">
      <p
        id="lang-status"
        class="lang-status"
        aria-live="polite"
        data-lessons={lessonSummary.lessons}
        data-recordings={videoCount}
      >
        Every language version is listed. Choose a language to show one recording per lesson.
      </p>
      <slot />
    </main>
    <SiteFooter />
    <PreviewDialog />
    <script is:inline src={`${import.meta.env.BASE_URL}lang-filter.js`}></script>
  </body>
</html>
