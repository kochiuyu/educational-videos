---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Player from '../../components/Player.astro';
import VideoRows from '../../components/VideoRows.astro';
import LanguageSwitch from '../../components/LanguageSwitch.astro';
import LessonQuiz from '../../components/LessonQuiz.astro';
import type { QuizItem } from '../../components/LessonQuiz.astro';
import {
  isStatLanguage,
  videos,
  type Video,
} from '../../data/catalog';
import { href, topicSlug, trackSlug } from '../../lib/urls';
import VisibleTitle from '../../components/VisibleTitle.astro';
import Description from '../../components/Description.astro';
import { casePageUrl, moduleTitleLang, presentDescription, teaSourceUrl } from '../../lib/text';
import { relatedVideos, statLessonLabel } from '../../lib/related';
import { lessonSlug, officialYoutubeTitle } from '../../lib/stat-lesson';
import type { Crumb } from '../../components/Breadcrumb.astro';
import statLessons from '../../../catalog/stat-lessons.json';

interface LessonRecord {
  quiz?: QuizItem[] | null;
}

export function getStaticPaths() {
  const byId = statLessons.videos as Record<string, LessonRecord>;
  return videos.map((video) => ({
    params: { youtubeId: video.youtube_id },
    props: {
      video,
      quiz: byId[video.youtube_id]?.quiz ?? null,
    },
  }));
}

const { video, quiz } = Astro.props as { video: Video; quiz: QuizItem[] | null };
const catalogIds = new Set(videos.map((item) => item.youtube_id));
const description = presentDescription(video, catalogIds);
const related = relatedVideos(video);
const lessonLabel = video.collection_slug === 'stat-lessons' ? statLessonLabel(video.youtube_id) : null;
const pageTitle = video.collection_slug === 'stat-lessons' ? officialYoutubeTitle(video) : video.title;

const crumbs: Crumb[] = [
  { href: href(), label: 'Home' },
  { href: href(`collections/${video.collection_slug}`), label: video.collection },
];
if (video.module) {
  crumbs.push({
    href: href(`stat-lessons/${video.module.toLowerCase()}`),
    label: video.module,
  });
  if (lessonLabel) {
    crumbs.push({
      href: href(`stat-lessons/${video.module.toLowerCase()}/${lessonSlug(lessonLabel)}`),
      label: `STAT ${lessonLabel}`,
    });
  }
} else if (
  video.collection_slug === 'economics-shorts' ||
  video.collection_slug === 'lae-what-is' ||
  video.collection_slug === 'micro-cases' ||
  video.collection_slug === 'tea-shorts'
) {
  crumbs.push({
    href: href(`${video.collection_slug}/${topicSlug(video.topic)}`),
    label: video.topic,
  });
}

const casePage = casePageUrl(video.description);
const teaSource = teaSourceUrl(video.description);

const meta = [
  pageTitle,
  video.collection,
  video.language_label,
  video.module && video.topic ? `${video.module} ${video.topic}` : video.topic,
]
  .filter((part): part is string => Boolean(part))
  .join(' · ');

const current =
  video.collection_slug === 'lae-101'
    ? 'lae'
    : video.collection_slug === 'lae-what-is'
      ? 'what'
      : video.collection_slug === 'economics-shorts'
        ? 'econ'
        : video.collection_slug === 'micro-cases'
          ? 'cases'
          : video.collection_slug === 'tea-shorts'
            ? 'tea'
            : 'stat';
---

<Base title={`${pageTitle} · Educational Videos`} description={meta} current={current}>
  <Breadcrumb items={crumbs} />
  <article class="detail watch">
    <div>
      <header class="watch-heading">
        {
          video.language_label ? (
            <p class="language-kicker">{video.language_label}</p>
          ) : (
            <p class="kicker">{video.collection}</p>
          )
        }
        {video.language_label && <p class="collection-line">{video.collection}</p>}
        <VisibleTitle video={video} heading />
      </header>
      <Player video={video} />
      <Description view={description} />
      {quiz && quiz.length > 0 && <LessonQuiz items={quiz} />}
      {
        related &&
          (video.collection_slug === 'stat-lessons' ||
          video.collection_slug === 'micro-cases' ||
          video.collection_slug === 'tea-shorts' ||
          video.collection_slug === 'lae-what-is' ? (
            <LanguageSwitch heading={related.heading} videos={related.videos} />
          ) : (
            <section class="section" aria-labelledby="related-heading">
              <h2 id="related-heading">{related.heading}</h2>
              <VideoRows videos={related.videos} showTopic={video.collection_slug === 'lae-101'} />
            </section>
          ))
      }
    </div>
    <aside class="facts" aria-label="About this video">
      <dl>
        <div>
          <dt>Collection</dt>
          <dd><a href={href(`collections/${video.collection_slug}`)}>{video.collection}</a></dd>
        </div>
        {
          lessonLabel && video.module && (
            <div class="lesson-fact">
              <dt>Lesson</dt>
              <dd>
                <a href={href(`stat-lessons/${video.module.toLowerCase()}/${lessonSlug(lessonLabel)}`)}>
                  STAT {lessonLabel}
                </a>
              </dd>
            </div>
          )
        }
        {
          video.module && (
            <div>
              <dt>Module</dt>
              <dd>
                <a href={href(`stat-lessons/${video.module.toLowerCase()}`)}>{video.module}</a>
              </dd>
            </div>
          )
        }
        {
          video.module_title && (
            <div>
              <dt>Module title</dt>
              <dd lang={moduleTitleLang(video.module_title)}>{video.module_title}</dd>
            </div>
          )
        }
        {
          video.topic && (
            <div class:list={[{ 'quiet-fact': Boolean(video.module) }]}>
              <dt>{video.module ? 'Catalog code' : 'Topic'}</dt>
              <dd>
                {video.module ? (
                  video.topic
                ) : video.collection_slug === 'economics-shorts' ||
                  video.collection_slug === 'lae-what-is' ||
                  video.collection_slug === 'micro-cases' ||
                  video.collection_slug === 'tea-shorts' ? (
                  <a href={href(`${video.collection_slug}/${topicSlug(video.topic)}`)}>{video.topic}</a>
                ) : (
                  video.topic
                )}
              </dd>
            </div>
          )
        }
        {
          video.language && video.language_label && (
            <div>
              <dt>{isStatLanguage(video.language) ? 'Language track' : 'Language'}</dt>
              <dd>
                {
                  isStatLanguage(video.language) ? (
                    <a href={href(`tracks/${trackSlug(video.language)}`)}>{video.language_label}</a>
                  ) : (
                    video.language_label
                  )
                }
              </dd>
            </div>
          )
        }
        {
          casePage && (
            <div>
              <dt>Case page</dt>
              <dd><a href={casePage}>{casePage}</a></dd>
            </div>
          )
        }
        {
          teaSource && (
            <div>
              <dt>Source</dt>
              <dd><a href={teaSource}>{teaSource}</a></dd>
            </div>
          )
        }
        {
          video.duration && (
            <div>
              <dt>Duration</dt>
              <dd>{video.duration}</dd>
            </div>
          )
        }
      </dl>
      <p class="watch-link">
        <a href={video.youtube_url}>Watch this video on YouTube</a>
      </p>
      <p class="quiet-id">Catalog ID <code>{video.id}</code></p>
    </aside>
  </article>
</Base>
