---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VideoRows from '../../components/VideoRows.astro';
import {
  statLanguages,
  moduleTitles,
  statModuleIds,
  videosInModule,
} from '../../data/catalog';
import { href, trackSlug } from '../../lib/urls';
import { lessonsInModule, ungroupedInModule } from '../../lib/stat-lesson';
import { moduleTitleLang } from '../../lib/text';

export function getStaticPaths() {
  return statModuleIds().map((moduleId) => ({
    params: { module: moduleId.toLowerCase() },
    props: { moduleId },
  }));
}

const { moduleId } = Astro.props;
const rows = videosInModule(moduleId);
const groups = lessonsInModule(moduleId);
const ungrouped = ungroupedInModule(moduleId);
const titles = moduleTitles(moduleId);
---

<Base
  title={`${moduleId} · STAT lessons · Educational Videos`}
  description={`STAT ${moduleId}: ${groups.length} lessons, ${rows.length} recordings.`}
  current="stat"
>
  <Breadcrumb
    items={[
      { href: href(), label: 'Home' },
      { href: href('collections/stat-lessons'), label: 'STAT lessons' },
      { label: moduleId },
    ]}
  />
  <header class="page-intro">
    <p class="eyebrow">STAT lessons</p>
    <h1>{moduleId}</h1>
    {
      titles.map((title) => (
        <p class="lede" lang={moduleTitleLang(title)}>
          {title}
        </p>
      ))
    }
    <p class="note">
      {groups.length} lessons · {rows.length} recordings. Each lesson is the number in the official title, with one recording for each language.
    </p>
    <p id="track-jump" class="kicker">Language tracks</p>
    <ul class="inline-links" aria-labelledby="track-jump">
      {
        statLanguages().map((language) => (
          <li>
            <a href={`${href(`tracks/${trackSlug(language.id)}`)}#${moduleId.toLowerCase()}`}>
              {language.label}
            </a>
          </li>
        ))
      }
    </ul>
  </header>

  {
    groups.map((group) => (
      <section
        class="topic-block"
        id={group.slug}
        data-lesson={group.label}
        aria-labelledby={`${group.slug}-heading`}
      >
        <h2 id={`${group.slug}-heading`}>
          <a href={href(`stat-lessons/${moduleId.toLowerCase()}/${group.slug}`)}>STAT {group.label}</a>
        </h2>
        <VideoRows videos={group.videos} showLanguage />
      </section>
    ))
  }
  {
    ungrouped.length > 0 && (
      <section class="topic-block" aria-labelledby="ungrouped-heading">
        <h2 id="ungrouped-heading">Titles without one lesson number</h2>
        <p class="note">These recordings are not placed in a lesson, because the official title does not contain exactly one lesson number.</p>
        <VideoRows videos={ungrouped} showLanguage />
      </section>
    )
  }
</Base>
