---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import VideoRows from '../../../components/VideoRows.astro';
import { statModuleIds } from '../../../data/catalog';
import { href } from '../../../lib/urls';
import { lessonsInModule } from '../../../lib/stat-lesson';

export function getStaticPaths() {
  const paths = [];
  for (const moduleId of statModuleIds()) {
    for (const group of lessonsInModule(moduleId)) {
      paths.push({
        params: { module: moduleId.toLowerCase(), topic: group.slug },
        props: { moduleId, group },
      });
    }
  }
  return paths;
}

const { moduleId, group } = Astro.props;
---

<Base
  title={`STAT ${group.label} · Educational Videos`}
  description={`STAT ${group.label}: ${group.videos.length} language versions.`}
  current="stat"
>
  <Breadcrumb
    items={[
      { href: href(), label: 'Home' },
      { href: href('collections/stat-lessons'), label: 'STAT lessons' },
      { href: href(`stat-lessons/${moduleId.toLowerCase()}`), label: moduleId },
      { label: `STAT ${group.label}` },
    ]}
  />
  <header class="page-intro">
    <p class="eyebrow">STAT lessons · {moduleId}</p>
    <h1>STAT {group.label}</h1>
    <p class="note">
      {group.videos.length} language versions of lesson {group.label}. Each title is the official title of that recording.
    </p>
  </header>
  <div data-lesson={group.label}>
    <VideoRows videos={group.videos} showLanguage />
  </div>
</Base>
