---
import Base from '../layouts/Base.astro';
import CardThumb from '../components/CardThumb.astro';
import {
  asOf,
  collections,
  formatLessonCount,
  lessonSummary,
  lessonTally,
  statLanguages,
  owner,
  siteTitle,
  statModuleIds,
  timezone,
  videoCount,
  videosInCollection,
  videosInModule,
  videosInTrack,
  moduleTitles,
  topicsInCollection,
  type Video,
} from '../data/catalog';
import { href, isPortraitCollection, topicSlug, trackSlug } from '../lib/urls';
import { moduleCover } from '../lib/stat-lesson';
import { catalogDateLine, moduleTitleLang } from '../lib/text';
import { collectionCardCopy } from '../../scripts/reader-copy.mjs';

const updated = catalogDateLine(asOf, timezone);
const description = `Lesson catalog by ${owner}. ${lessonSummary.lessons} distinct lessons. ${videoCount} recordings, including language versions.`;
const economicsTopics = topicsInCollection('economics-shorts');
const laeWhatTopics = topicsInCollection('lae-what-is');
const microTopics = topicsInCollection('micro-cases');
const teaTopics = topicsInCollection('tea-shorts');

function collectionCover(slug: string): Video | undefined {
  if (slug === 'stat-lessons') {
    const firstModule = statModuleIds()[0];
    return firstModule ? moduleCover(firstModule) : undefined;
  }
  return videosInCollection(slug)[0];
}
---

<Base title={`${siteTitle} · ${owner}`} description={description} current="home">
  <header class="page-intro home-hero">
    <h1>Lesson catalog</h1>
    <p class="lede" id="catalog-counts">
      {lessonSummary.lessons} distinct lessons. {videoCount} recordings, including language versions.
    </p>
    <p class="note">Titles are the published titles. Updated {updated}. {owner}.</p>
    <form class="home-search" role="search" action={href('search')} method="get">
      <div class="field">
        <label for="home-q">Search the catalog</label>
        <input id="home-q" name="q" type="search" autocomplete="off" enterkeyhint="search" />
      </div>
      <button type="submit">Search</button>
    </form>
  </header>

  <section class="section" aria-labelledby="collections-heading">
    <h2 id="collections-heading">Collections</h2>
    <ul class="collection-grid">
      {
        collections.map((collection) => {
          const counts = lessonSummary.byCollection[collection.slug];
          const sample = collectionCover(collection.slug);
          const portrait = isPortraitCollection(collection.slug);
          return (
            <li>
              <a class="sheet-link" href={href(`collections/${collection.slug}`)}>
                {
                  sample && (
                    <CardThumb
                      youtubeId={sample.youtube_id}
                      collection={collection.slug}
                      frame={portrait ? 'mat' : 'wide'}
                      eager
                    />
                  )
                }
                <h3>{collection.name}</h3>
                <p>{collectionCardCopy(collection)}</p>
                <p class="count">{formatLessonCount(counts.lessons, counts.versions)}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="modules-heading">
    <h2 id="modules-heading">STAT modules</h2>
    <p class="note">Open a module to see its lessons in official number order.</p>
    <ul class="module-grid modules">
      {
        statModuleIds().map((moduleId) => {
          const titles = moduleTitles(moduleId);
          const counts = lessonTally(videosInModule(moduleId));
          const cover = moduleCover(moduleId);
          return (
            <li>
              <a class="sheet-link" href={href(`stat-lessons/${moduleId.toLowerCase()}`)}>
                {
                  cover && (
                    <CardThumb youtubeId={cover.youtube_id} collection="stat-lessons" eager />
                  )
                }
                <span class="code">{moduleId}</span>
                {
                  titles.map((title) => (
                    <span class="module-title" lang={moduleTitleLang(title)}>
                      {title}
                    </span>
                  ))
                }
                <p class="count">{formatLessonCount(counts.lessons, counts.versions)}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="lae-what-heading">
    <h2 id="lae-what-heading">LAE What-is</h2>
    <ul class="topic-grid">
      {
        laeWhatTopics.map((group) => {
          const sample = group.videos[0];
          return (
            <li>
              <a class="sheet-link" href={href(`lae-what-is/${topicSlug(group.topic)}`)}>
                {
                  sample && (
                    <CardThumb youtubeId={sample.youtube_id} collection="lae-what-is" />
                  )
                }
                <h3>{group.topic}</h3>
                <p class="count">
                  {group.videos.length === 1
                    ? '1 language version'
                    : `${group.videos.length} language versions`}
                </p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="economics-heading">
    <h2 id="economics-heading">Economics Shorts</h2>
    <ul class="short-grid">
      {
        economicsTopics.map((group) => {
          const sample = group.videos[0];
          const shorts = lessonTally(group.videos).lessons;
          return (
            <li>
              <a class="sheet-link" href={href(`economics-shorts/${topicSlug(group.topic)}`)}>
                {
                  sample && (
                    <CardThumb
                      youtubeId={sample.youtube_id}
                      collection="economics-shorts"
                      frame="poster"
                    />
                  )
                }
                <h3>{group.topic}</h3>
                <p class="count">{shorts === 1 ? '1 short' : `${shorts} shorts`}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="micro-heading">
    <h2 id="micro-heading">Micro Cases</h2>
    <ul class="topic-grid">
      {
        microTopics.map((group) => {
          const counts = lessonTally(group.videos);
          const sample = group.videos.find((video) => video.language === 'mc-en') ?? group.videos[0];
          return (
            <li>
              <a class="sheet-link" href={href(`micro-cases/${topicSlug(group.topic)}`)}>
                {
                  sample && (
                    <CardThumb youtubeId={sample.youtube_id} collection="micro-cases" frame="wide" />
                  )
                }
                <h3>{group.topic}</h3>
                <p class="count">{formatLessonCount(counts.lessons, counts.versions)}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="tea-heading">
    <h2 id="tea-heading">Tea Shorts</h2>
    <ul class="short-grid">
      {
        teaTopics.map((group) => {
          const counts = lessonTally(group.videos);
          const sample = group.videos.find((video) => video.language === 'tea-en') ?? group.videos[0];
          return (
            <li>
              <a class="sheet-link" href={href(`tea-shorts/${topicSlug(group.topic)}`)}>
                {
                  sample && (
                    <CardThumb
                      youtubeId={sample.youtube_id}
                      collection="tea-shorts"
                      frame="poster"
                      thumbnail={sample.thumbnail}
                    />
                  )
                }
                <h3>{group.topic}</h3>
                <p class="count">{formatLessonCount(counts.lessons, counts.versions)}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="tracks-heading">
    <h2 id="tracks-heading">STAT language tracks</h2>
    <p class="note">
      These list language versions of STAT lessons only. They are not extra lessons.
      LAE 101, LAE What-is, Economics Shorts, Micro Cases, and Tea Shorts are not listed here.
    </p>
    <ul class="inline-links track-picks">
      {
        statLanguages().map((language) => (
          <li>
            <a href={href(`tracks/${trackSlug(language.id)}`)}>
              {language.label}
              <span class="count"> · {videosInTrack(language.id).length} recordings</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
