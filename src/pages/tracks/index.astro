---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { statLanguages, videosInTrack } from '../../data/catalog';
import { href, trackSlug } from '../../lib/urls';
---

<Base
  title="Language tracks · Educational Videos"
  description="STAT lesson videos grouped by language track."
  current="tracks"
>
  <Breadcrumb
    items={[
      { href: href(), label: 'Home' },
      { label: 'Language tracks' },
    ]}
  />
  <header class="page-intro">
    <p class="eyebrow">STAT lessons</p>
    <h1>Language tracks</h1>
    <p class="lede">
      Four narration and slide pairings for STAT lessons. LAE 101, LAE What-is, Economics Shorts, Micro Cases, and Tea Shorts are not language tracks.
    </p>
  </header>
  <ul class="track-grid">
    {
      statLanguages().map((language) => (
        <li>
          <a class="sheet-link" href={href(`tracks/${trackSlug(language.id)}`)}>
            <h2>{language.label}</h2>
            <p class="count">{videosInTrack(language.id).length} videos</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
