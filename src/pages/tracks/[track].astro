---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import {
  languageBySlug,
  statLanguages,
  statModuleIds,
  videosInModule,
  videosInTrack,
} from '../../data/catalog';
import VideoRows from '../../components/VideoRows.astro';
import { canonicalLesson } from '../../lib/stat-lesson';
import { href, trackSlug } from '../../lib/urls';

export function getStaticPaths() {
  return statLanguages().map((language) => ({
    params: { track: trackSlug(language.id) },
    props: { languageId: language.id },
  }));
}

const { languageId } = Astro.props;
const language = languageBySlug(trackSlug(languageId));
if (!language) {
  throw new Error(`Unknown language track ${languageId}`);
}
const rows = videosInTrack(language.id);
const modules = statModuleIds()
  .map((moduleId) => ({
    moduleId,
    videos: videosInModule(moduleId)
      .filter((video) => video.language === language.id)
      .sort((a, b) => {
        const left = canonicalLesson(a)?.label ?? 'unmapped';
        const right = canonicalLesson(b)?.label ?? 'unmapped';
        return left.localeCompare(right, undefined, { numeric: true });
      }),
  }))
  .filter((group) => group.videos.length > 0);
---

<Base
  title={`${language.label} · Educational Videos`}
  description={`${language.label}: ${rows.length} STAT lesson videos.`}
  current="tracks"
>
  <Breadcrumb
    items={[
      { href: href(), label: 'Home' },
      { href: href('tracks'), label: 'Language tracks' },
      { label: language.label },
    ]}
  />
  <header class="page-intro">
    <p class="eyebrow">Language track</p>
    <h1>{language.label}</h1>
    <p class="note">{rows.length} videos in the STAT lessons collection.</p>
  </header>
  {
    modules.map((group) => (
      <section class="topic-block" id={group.moduleId.toLowerCase()} aria-labelledby={`${group.moduleId}-heading`}>
        <h2 id={`${group.moduleId}-heading`}>
          <a href={href(`stat-lessons/${group.moduleId.toLowerCase()}`)}>{group.moduleId}</a>
        </h2>
        <VideoRows videos={group.videos} showLesson />
      </section>
    ))
  }
</Base>
