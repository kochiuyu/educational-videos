---
import Base from '../../layouts/Base.astro';
import VideoRows from '../../components/VideoRows.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CardThumb from '../../components/CardThumb.astro';
import CollectionDescription from '../../components/CollectionDescription.astro';
import {
  collections,
  formatLessonCount,
  lessonTally,
  moduleTitles,
  statModuleIds,
  topicsInCollection,
  videosInCollection,
  videosInModule,
} from '../../data/catalog';
import { href, topicSlug } from '../../lib/urls';
import { lessonsInModule, moduleCover } from '../../lib/stat-lesson';
import { moduleTitleLang } from '../../lib/text';
import { readerIntro } from '../../../scripts/reader-copy.mjs';

export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

const { collection } = Astro.props;
const list = videosInCollection(collection.slug);
const isStat = collection.slug === 'stat-lessons';
const topicBase =
  collection.slug === 'economics-shorts' ||
  collection.slug === 'lae-what-is' ||
  collection.slug === 'micro-cases'
    ? collection.slug
    : null;
const topicGroups = topicBase ? topicsInCollection(collection.slug) : [];
const current =
  collection.slug === 'lae-101'
    ? 'lae'
    : collection.slug === 'lae-what-is'
      ? 'what'
      : collection.slug === 'economics-shorts'
        ? 'econ'
        : collection.slug === 'micro-cases'
          ? 'cases'
          : 'stat';
---

<Base
  title={`${collection.name} · Educational Videos`}
  description={`${readerIntro(collection.description)} ${list.length} videos.`}
  current={current}
>
  <Breadcrumb
    items={[
      { href: href(), label: 'Home' },
      { label: collection.name },
    ]}
  />
  <header class="page-intro">
    <p class="eyebrow">Collection</p>
    <h1>{collection.name}</h1>
    <CollectionDescription class="lede" description={collection.description} />
    <p class="note">
      {
        collection.slug === 'micro-cases'
          ? `${formatLessonCount(lessonTally(list).lessons, lessonTally(list).versions)}.`
          : `${list.length} videos.`
      }
    </p>
    {
      isStat && (
        <p class="note">
          A lesson is the number in the official title, such as STAT 1.01. The catalog topic code is not that number.
        </p>
      )
    }
  </header>

  {
    isStat ? (
      <section class="section" aria-labelledby="module-list-heading">
        <h2 id="module-list-heading">Modules</h2>
        <ul class="module-grid modules">
          {statModuleIds().map((moduleId) => {
            const titles = moduleTitles(moduleId);
            const rows = videosInModule(moduleId);
            const lessons = lessonsInModule(moduleId).length;
            const cover = moduleCover(moduleId);
            return (
              <li>
                <a class="sheet-link" href={href(`stat-lessons/${moduleId.toLowerCase()}`)}>
                  {cover && <CardThumb youtubeId={cover.youtube_id} collection="stat-lessons" />}
                  <span class="code">{moduleId}</span>
                  {titles.map((title) => (
                    <span class="module-title" lang={moduleTitleLang(title)}>
                      {title}
                    </span>
                  ))}
                  <p class="count">
                    {lessons} lessons · {rows.length} recordings
                  </p>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ) : topicBase ? (
      topicGroups.map((group) => (
        <section class="topic-block" id={topicSlug(group.topic)} aria-labelledby={`${topicSlug(group.topic)}-heading`}>
          <h2 id={`${topicSlug(group.topic)}-heading`}>
            <a href={href(`${topicBase}/${topicSlug(group.topic)}`)}>{group.topic}</a>
          </h2>
          <p class="note">
            {
              collection.slug === 'micro-cases'
                ? formatLessonCount(lessonTally(group.videos).lessons, lessonTally(group.videos).versions)
                : `${group.videos.length} videos.`
            }
          </p>
          <VideoRows
            videos={group.videos}
            showLanguage={collection.slug === 'lae-what-is' || collection.slug === 'micro-cases'}
          />
        </section>
      ))
    ) : (
      <section class="section" aria-labelledby="video-list-heading">
        <h2 id="video-list-heading">Videos</h2>
        <VideoRows videos={list} showTopic />
      </section>
    )
  }
</Base>
