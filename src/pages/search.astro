---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import {
  collections,
  statLanguages,
  statModuleIds,
  topicsInCollection,
  videoCount,
  videos,
} from '../data/catalog';
import VideoCard from '../components/VideoCard.astro';
import { lessonAttrs } from '../lib/lang-pref';
import { href, trackSlug } from '../lib/urls';
import { canonicalLesson } from '../lib/stat-lesson';
import { haystack } from '../lib/text';

const statLessonOptions = new Map<string, string[]>();
const laeTopics: string[] = [];
for (const video of videos) {
  if (video.collection_slug === 'stat-lessons' && video.module) {
    const lesson = canonicalLesson(video);
    if (!lesson) continue;
    const list = statLessonOptions.get(video.module) ?? [];
    if (!list.includes(lesson.label)) list.push(lesson.label);
    statLessonOptions.set(video.module, list);
  }
  if (video.collection_slug === 'lae-101' && !laeTopics.includes(video.topic)) {
    laeTopics.push(video.topic);
  }
}
for (const list of statLessonOptions.values()) {
  list.sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
}
const econTopics = topicsInCollection('economics-shorts').map((group) => group.topic);
const laeWhatTopics = topicsInCollection('lae-what-is').map((group) => group.topic);
const microTopics = topicsInCollection('micro-cases').map((group) => group.topic);
const teaTopics = topicsInCollection('tea-shorts').map((group) => group.topic);
const modules = statModuleIds();
---

<Base
  title="Search · Educational Videos"
  description={`Search and filter ${videoCount} videos by collection, module, topic, and language track.`}
  current="search"
>
  <Breadcrumb
    items={[
      { href: href(), label: 'Home' },
      { label: 'Search' },
    ]}
  />
  <header class="page-intro">
    <p class="eyebrow">Catalog</p>
    <h1>Search</h1>
    <p class="lede">
      Search titles and descriptions. The language control in the header shows one recording per lesson.
      All languages lists every version. The language-track filter lists STAT lessons only.
    </p>
  </header>

  <form id="filters" class="filters" method="get" action={href('search')} role="search" aria-controls="results">
    <div class="search-field">
      <label for="q">Search titles and descriptions</label>
      <input
        id="q"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="A title, a phrase, or a catalog ID"
      />
    </div>
    <div>
      <label for="collection">Collection</label>
      <select id="collection" name="collection">
        <option value="">All collections</option>
        {collections.map((collection) => <option value={collection.slug}>{collection.name}</option>)}
      </select>
    </div>
    <div>
      <label for="module">Module</label>
      <select id="module" name="module">
        <option value="">All modules</option>
        {modules.map((moduleId) => <option value={moduleId}>{moduleId}</option>)}
      </select>
    </div>
    <div>
      <label for="topic">Topic</label>
      <select id="topic" name="topic">
        <option value="">All topics</option>
        {
          [...statLessonOptions.entries()].map(([moduleId, labels]) => (
            <optgroup label={`STAT ${moduleId}`}>
              {labels.map((label) => (
                <option value={label}>STAT {label}</option>
              ))}
            </optgroup>
          ))
        }
        <optgroup label="LAE 101">
          {laeTopics.map((topic) => <option value={topic}>{topic}</option>)}
        </optgroup>
        <optgroup label="LAE What-is">
          {laeWhatTopics.map((topic) => <option value={topic}>{topic}</option>)}
        </optgroup>
        <optgroup label="Economics Shorts">
          {econTopics.map((topic) => <option value={topic}>{topic}</option>)}
        </optgroup>
        <optgroup label="Micro Cases">
          {microTopics.map((topic) => <option value={topic}>{topic}</option>)}
        </optgroup>
        <optgroup label="Tea Shorts">
          {teaTopics.map((topic) => <option value={topic}>{topic}</option>)}
        </optgroup>
      </select>
    </div>
    <div>
      <label for="language">STAT language track</label>
      <select id="language" name="language">
        <option value="">All</option>
        {
          statLanguages().map((language) => (
            <option value={trackSlug(language.id)}>{language.label}</option>
          ))
        }
      </select>
    </div>
    <div class="filter-actions">
      <button type="submit">Apply filters</button>
      <a class="button secondary" href={href('search')}>Clear filters</a>
    </div>
  </form>

  <p id="result-count" class="result-count" aria-live="polite">Showing all {videoCount} videos.</p>
  <p id="empty" hidden>No videos match these filters.</p>

  <ul id="results" class="video-grid">
    {
      videos.map((video) => {
        const lesson = video.collection_slug === 'stat-lessons' ? canonicalLesson(video) : null;
        const context = [
          video.collection,
          lesson ? `STAT ${lesson.label}` : video.module ? `${video.module} ${video.topic}` : video.topic,
          video.language_label,
        ]
          .filter((part): part is string => Boolean(part))
          .join(' · ');
        return (
          <li
            data-collection={video.collection_slug}
            data-module={video.module ?? ''}
            data-topic={lesson ? lesson.label : video.topic}
            data-language={video.language ? trackSlug(video.language) : ''}
            data-haystack={haystack(video)}
            {...lessonAttrs(video)}
          >
            <VideoCard video={video} meta={context} />
          </li>
        );
      })
    }
  </ul>
</Base>
