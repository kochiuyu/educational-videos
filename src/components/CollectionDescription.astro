---
import { COMPANION_URL, readerIntro } from '../../scripts/reader-copy.mjs';

interface Props {
  description: string;
  class?: string;
}

const { description, class: className } = Astro.props;
const intro = readerIntro(description);
const companion = description.includes(COMPANION_URL);
---

<p class={className}>{intro}</p>
{
  companion && (
    <p class="note">
      <a href={COMPANION_URL}>Companion site</a>
    </p>
  )
}
