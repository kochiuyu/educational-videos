---
import { asOf, channelUrl, owner, timezone, videoCount } from '../data/catalog';
import { catalogDateLine } from '../lib/text';

const updated = catalogDateLine(asOf, timezone);
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <p>
      Updated {updated}. {videoCount} public videos. {owner}.
    </p>
    <p>
      Channel for attribution only:
      <a href={channelUrl}>youtube.com/@ChiuYuKo</a>.
      This site does not copy videos from the channel.
    </p>
    <p>Playback uses a YouTube player embedded on the video page. This site does not host video files.</p>
  </div>
</footer>
