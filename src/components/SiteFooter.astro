---
import { asOf, channelUrl, lessonSummary, owner, timezone, videoCount } from '../data/catalog';
import { catalogDateLine } from '../lib/text';

const updated = catalogDateLine(asOf, timezone);
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <p>
      Updated {updated}. {lessonSummary.lessons} lessons · {videoCount} recordings, including language versions. {owner}.
    </p>
    <p>
      Channel for attribution only:
      <a href={channelUrl}>youtube.com/@ChiuYuKo</a>.
      This site does not copy videos from the channel.
    </p>
    <p>Playback uses a YouTube player embedded on the video page. This site does not host video files.</p>
    <p>
      This website is related to a Teaching Development and Language Enhancement Grant (TDLEG) 2025–28 project at The Chinese University of Hong Kong: “Enhancing Multilingual Learning through AI-Translated Videos: Experimental Insights on Language, Speed, and Repetition Effects.”
    </p>
    <p>References:</p>
    <ul class="credit-links">
      <li>
        <a
          href="https://www.ugc.edu.hk/eng/ugc/activity/teach_learn/tdleg.html"
          target="_blank"
          rel="noopener noreferrer"
        >
          Teaching Development and Language Enhancement Grant, University Grants Committee
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </li>
      <li>
        <a
          href="https://www.aqs.cuhk.edu.hk/funding-schemes-administered-by-aqs/tdleg-2025-28-triennium/"
          target="_blank"
          rel="noopener noreferrer"
        >
          TDLEG 2025–28 Triennium, Academic and Quality Section, The Chinese University of Hong Kong
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </li>
    </ul>
  </div>
</footer>
