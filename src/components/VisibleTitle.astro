---
import type { Video } from '../data/catalog';
import { officialYoutubeTitle } from '../lib/stat-lesson';
import { splitPublishedTitle, titleLang } from '../lib/text';

interface Props {
  video: Video;
  heading?: boolean;
}

const { video, heading = false } = Astro.props;
const source =
  video.collection_slug === 'stat-lessons' ? officialYoutubeTitle(video) : video.title;
const parts =
  video.collection_slug === 'economics-shorts'
    ? splitPublishedTitle(source)
    : { headline: source, tags: [] as string[] };
const headline = parts.headline || source;
const tags = parts.headline ? parts.tags : [];
const lang = titleLang({ title: headline, language: video.language });
---

{
  heading ? (
    <h1 class="watch-title" lang={lang}>
      {headline}
    </h1>
  ) : (
    <span class="video-card-title" lang={lang}>
      {headline}
    </span>
  )
}
{
  tags.length > 0 && (
    <ul class="tag-row">
      {tags.map((tag) => (
        <li class="tag">#{tag}</li>
      ))}
    </ul>
  )
}
