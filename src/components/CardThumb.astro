---
import { thumbnailFallbackUrl, thumbnailUrl } from '../lib/urls';

interface Props {
  youtubeId: string;
  collection: string;
  frame?: 'wide' | 'poster' | 'mat';
  eager?: boolean;
  thumbnail?: string | null;
}

const { youtubeId, collection, frame = 'wide', eager = false, thumbnail = null } = Astro.props;
const portrait = frame !== 'wide';
const cropped = portrait && Boolean(thumbnail) && thumbnail !== 'oardefault.jpg';
---

<span class:list={['card-thumb', frame]}>
  <img
    class:list={{ 'fit-cover': cropped }}
    src={thumbnailUrl(youtubeId, collection, thumbnail)}
    data-fallback={thumbnailFallbackUrl(youtubeId)}
    alt=""
    width={portrait ? 1080 : 1280}
    height={portrait ? 1920 : 720}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    onerror="this.onerror=null;var next=this.dataset.fallback;if(next){this.removeAttribute('data-fallback');this.src=next;}"
  />
</span>
