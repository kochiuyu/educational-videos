---
import type { Video } from '../data/catalog';
import VideoCard from './VideoCard.astro';

interface Props {
  videos: Video[];
  showTopic?: boolean;
  showLanguage?: boolean;
}

const { videos, showTopic = false, showLanguage = false } = Astro.props;
const shorts = videos.length > 0 && videos.every((video) => video.collection_slug === 'economics-shorts');

function metaLabel(video: Video): string {
  const parts: string[] = [];
  if (showLanguage && video.language_label) parts.push(video.language_label);
  if (showTopic) parts.push(video.module ? `${video.module} ${video.topic}` : video.topic);
  return parts.join(' · ');
}
---

<ul class:list={['video-grid', { shorts }]}>
  {
    videos.map((video) => (
      <li>
        <VideoCard video={video} meta={metaLabel(video)} />
      </li>
    ))
  }
</ul>
