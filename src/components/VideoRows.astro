---
import type { Video } from '../data/catalog';
import { href } from '../lib/urls';
import { titleLang } from '../lib/text';

interface Props {
  videos: Video[];
  showTopic?: boolean;
}

const { videos, showTopic = false } = Astro.props;

function metaLabel(video: Video): string {
  const parts: string[] = [];
  if (video.language_label) parts.push(video.language_label);
  if (showTopic) {
    parts.push(video.module ? `${video.module} ${video.topic}` : `Topic ${video.topic}`);
  }
  return parts.join(' · ');
}
---

<ul class="track-list">
  {
    videos.map((video) => (
      <li>
        <a href={href(`videos/${video.youtube_id}`)}>
          <span class="meta">
            {metaLabel(video) && <span>{metaLabel(video)}</span>}
            {video.duration && (
              <span>
                {metaLabel(video) ? ' · ' : ''}
                <span class="sr-only">Duration </span>
                {video.duration}
              </span>
            )}
          </span>
          <span class="title" lang={titleLang(video)}>
            {video.title}
          </span>
        </a>
      </li>
    ))
  }
</ul>
