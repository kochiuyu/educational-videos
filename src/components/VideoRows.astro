---
import type { Video } from '../data/catalog';
import { lessonAttrs } from '../lib/lang-pref';
import { canonicalLesson } from '../lib/stat-lesson';
import { isPortraitCollection } from '../lib/urls';
import VideoCard from './VideoCard.astro';

interface Props {
  videos: Video[];
  showTopic?: boolean;
  showLanguage?: boolean;
  showLesson?: boolean;
}

const { videos, showTopic = false, showLanguage = false, showLesson = false } = Astro.props;
const shorts = videos.length > 0 && videos.every((video) => isPortraitCollection(video.collection_slug));

function metaLabel(video: Video): string {
  const parts: string[] = [];
  if (showLanguage && video.language_label) parts.push(video.language_label);
  if (showLesson) {
    const lesson = canonicalLesson(video);
    if (lesson) parts.push(`STAT ${lesson.label}`);
  } else if (showTopic) {
    parts.push(video.module ? `${video.module} ${video.topic}` : video.topic);
  }
  return parts.join(' · ');
}
---

<ul class:list={['video-grid', { shorts }]}>
  {
    videos.map((video) => (
      <li {...lessonAttrs(video)}>
        <VideoCard video={video} meta={metaLabel(video)} />
      </li>
    ))
  }
</ul>
